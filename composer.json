{
    "name": "mortezamasumi/test-gh-action",
    "description": "test github actionss",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Morteza Masumi",
            "email": "morteza.masumi@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "laravel/legacy-factories": "^1.4",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.6",
        "pestphp/pest-plugin-faker": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Mortezamasumi\\TestGhAction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mortezamasumi\\TestGhAction\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mortezamasumi\\TestGhAction\\TestGhActionServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
